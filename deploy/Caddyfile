# O Caddy pega sozinho um certificado HTTPS (Let's Encrypt) para o domínio e renova antes de vencer.
# Quem acessar por http:// é mandado para https://. Ele avisa a API do IP e do https verdadeiros
# pelos cabeçalhos X-Forwarded-For e X-Forwarded-Proto.
{$DOMINIO} {
	encode gzip
	reverse_proxy api:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# A demonstração (somente leitura), outra instância da API
{$DOMINIO_DEMO} {
	encode gzip
	reverse_proxy api-demo:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Outros projetos na mesma VM (o Pursuit) põem o site deles em ~/beacon/sites/ e recarregam o Caddy
import /etc/caddy/sites/*.caddy
